{
  "name": "dfe-agent-learning-rag",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de RAG meta-cognitivo do DFe-Agent. Captura aprendizados de agents e sessoes, persiste em .claude/rag.db e injeta contexto relevante em prompts futuros.",
  "type": "module",
  "scripts": {
    "summarize": "tsx .claude/scripts/summarize.ts",
    "embed": "tsx .claude/scripts/embed.ts",
    "search": "tsx .claude/scripts/search.ts",
    "init": "tsx .claude/scripts/init_db.ts",
    "test": "tsx .claude/scripts/smoke_test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "sqlite-vec": "^0.1.6",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5"
  },
  "engines": {
    "node": ">=20"
  }
}