# =============================================================================
# DFe-Agent — variaveis de ambiente (exemplo)
# Copie este arquivo para `.env` e ajuste os valores. Nunca versione o `.env`.
# =============================================================================

# Diretorio raiz do banco SQLite (relacional + vetorial).
DFE_STORAGE_DIR=./storage

# Diretorio onde o coletor grava os PDFs/HTML baixados.
DFE_DATA_DIR=./data

# Intervalo minimo entre requisicoes HTTP aos portais oficiais (ms).
# Usado pelo Throttler para nao "metralhar" os sites da Fazenda.
DFE_REQUEST_INTERVAL_MS=2000

# Jitter adicionado ao intervalo base para evitar padroes previsiveis (ms).
DFE_REQUEST_JITTER_MS=500

# Score minimo (0-1) para que um chunk seja considerado evidencia suficiente
# para fundamentar uma resposta. Abaixo disso, o agente declara ausencia de base.
DFE_MIN_RELEVANCE_SCORE=0.5

# Top-K chunks retornados pela busca semantica antes do filtro de relevancia.
DFE_QUERY_TOP_K=5

# Modelo de embeddings multilangue usado pelo EmbeddingProvider.
# Padrao: paraphrase-multilingual-MiniLM-L12-v2 (384 dimensoes, ~500MB download).
DFE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Precisao numerica dos pesos do modelo de embedding.
# Padrao: float32. Use float16 em Windows com page file limitado
# (reduz ~50% o footprint com perda minima de precisao).
DFE_EMBEDDING_DTYPE=float32

# Diretorios de fontes oficiais permitidas (separados por virgula).
# Hook domain_guard valida toda requisicao contra esta lista.
# Atualizado em 2026: MDF-e migrou para dfe-portal.svrs.rs.gov.br;
# SPED migrou para sped.gov.br; www.gov.br removido (PLAN_SPRINT5 A.2).
DFE_ALLOWED_DOMAINS=nfe.fazenda.gov.br,nfce.fazenda.gov.br,cte.fazenda.gov.br,mdfe.fazenda.gov.br,sped.rfb.gov.br,sped.gov.br,confaz.fazenda.gov.br,dfe-portal.svrs.rs.gov.br
