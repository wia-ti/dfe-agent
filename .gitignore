# Exclusoes do repositorio. Artefatos locais do harness Claude Code
# (rag.db, node_modules, settings.local.json) ficam em .claude/.gitignore.

# Dependências
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
dist/
build/
site-packages/
pip-wheel-metadata/

# Build e arquivos gerados
build/
dist/
*.spec
*.manifest
*.egg-info/
*.whl
*.tar.gz
docs/_build/
_site/

# Segredos e variáveis de ambiente
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*
credentials.*
*.secret

# Banco de dados local
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm
storage/*.sqlite
storage/*.sqlite3
storage/*.sqlite-journal
storage/*.sqlite-wal
storage/*.sqlite-shm
data/*.db
data/*.db.gz
data/*.db.gz.sha256
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Harness Claude Code: ver .claude/.gitignore
node_modules/

# Uploads e mídia
data/raw/
data/uploads/
data/media/
uploads/
media/
tmp/
temp/

# Cache e logs
logs/
*.log
*.log.*
.cache/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Scripts ad-hoc gerados pelo agente LLM (impede reincidencia — ver PLAN_SPRINT5.md F.2)
# Apenas scripts canonicos declarados explicitamente sao versionados.
scripts/*.py
!scripts/demo_cli.py

# Pacotes npm (Sprint 14)
# O source em packages/*/src e versionado; dist/ e node_modules/ nao.
packages/*/dist/
packages/*/node_modules/
packages/*/*.tsbuildinfo
packages/*/coverage/
# Seed da base RAG: FORCAR versionamento (asset bundleado, ~5MB gzip)
!packages/dfe-agent/src/seed/
