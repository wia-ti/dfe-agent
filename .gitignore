# OpenCode não possui arquivo de exclusão próprio e depende do .gitignore.
# Este arquivo cobre as mesmas categorias do .claudeignore para garantir
# que contexto sensível/irrelevante nunca seja carregado pelo agente.

# Dependências
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
dist/
build/
site-packages/
pip-wheel-metadata/

# Build e arquivos gerados
build/
dist/
*.spec
*.manifest
*.egg-info/
*.whl
*.tar.gz
docs/_build/
_site/

# Segredos e variáveis de ambiente
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*
credentials.*
*.secret

# Banco de dados local
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm
storage/*.sqlite
storage/*.sqlite3
storage/*.sqlite-journal
storage/*.sqlite-wal
storage/*.sqlite-shm
data/*.db
data/*.db.gz
data/*.db.gz.sha256
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Sistema de RAG meta-cognitivo (.claude/)
.claude/rag.db
.claude/rag.db-journal
.claude/rag.db-wal
.claude/rag.db-shm
.claude/knowledge/
.claude/state/
.claude/inject-*.json
.claude/node_modules/
.claude/dist/
.claude/.cache/
node_modules/

# Uploads e mídia
data/raw/
data/uploads/
data/media/
uploads/
media/
tmp/
temp/

# Cache e logs
logs/
*.log
*.log.*
.cache/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# OpenCode
.opencode/cache/
.opencode/log/
.opencode/sessions/
.opencode/state/
.opencode/opencode.json
.opencode/node_modules/
.opencode/package-lock.json

# Scripts ad-hoc gerados pelo agente LLM (impede reincidencia — ver PLAN_SPRINT5.md F.2)
# Apenas scripts canonicos declarados explicitamente sao versionados.
scripts/*.py
!scripts/demo_cli.py

# Pacotes npm (Sprint 14)
# O source em packages/*/src e versionado; dist/ e node_modules/ nao.
packages/*/dist/
packages/*/node_modules/
packages/*/*.tsbuildinfo
packages/*/coverage/
# Seed da base RAG: FORCAR versionamento (asset bundleado, ~5MB gzip)
!packages/dfe-agent/src/seed/
